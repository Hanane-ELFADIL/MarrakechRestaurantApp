<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Image de fond -->
    <item>
        <bitmap
            android:src="@drawable/bg"
            android:gravity="fill" />
    </item>

    <!-- Overlay dégradé rouge transparent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#CC8B0000"
                android:centerColor="#99D32F2F"
                android:endColor="#66FF5722"
                android:type="linear" />
        </shape>
    </item>

</layer-list>