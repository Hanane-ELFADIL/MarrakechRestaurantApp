<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- STYLE CORRECT POUR BORDURE ROUGE -->
    <style name="RedOutlinedTextInput"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <!-- OBLIGATOIRE -->
        <item name="boxBackgroundMode">outline</item>

        <!-- BORDURE -->
        <item name="boxStrokeColor">@color/primary_red</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <!-- HINT -->
        <item name="hintTextColor">@color/text_white</item>
    </style>

</resources>
