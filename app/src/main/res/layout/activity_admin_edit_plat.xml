<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/background_light">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nom du plat -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du plat *"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edtNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:textColor="@color/text_primary"
            android:hint="Ex: Tajine de poulet"
            android:textColorHint="@color/text_hint"
            android:padding="12dp"/>

        <!-- Catégorie -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catégorie *"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerCategorie"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"/>

        <!-- Prix -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prix (MAD) *"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edtPrix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:textColor="@color/text_primary"
            android:hint="Ex: 65.00"
            android:textColorHint="@color/text_hint"
            android:padding="12dp"/>

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description *"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:textColor="@color/text_primary"
            android:hint="Description détaillée du plat..."
            android:textColorHint="@color/text_hint"
            android:padding="12dp"/>



        <!-- Image du plat -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Image du plat"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_food_placeholder"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"
            android:background="#F0F0F0"
            android:contentDescription="Aperçu de l'image du plat"/>

        <Spinner
            android:id="@+id/spinnerImages"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:background="@color/white"/>


        <!-- Restaurant -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurant *"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerRestaurants"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@color/white"/>

        <!-- Disponibilité -->
        <Switch
            android:id="@+id/switchDisponible"
            android:text="Disponible"
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:checked="true"
            android:textColor="@color/text_primary"/>

        <!-- Bouton Enregistrer -->
        <Button
            android:id="@+id/btnSave"
            android:text="Enregistrer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:elevation="4dp"/>

    </LinearLayout>
</ScrollView>