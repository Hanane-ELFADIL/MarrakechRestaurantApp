<?xml version="1.0" encoding="utf-8"?>
<!-- CARTE POUR CHAQUE PLAT DANS LE PANIER -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="3dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- NOM DU PLAT -->
        <TextView
            android:id="@+id/textViewNomPlat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonRemove"
            android:layout_marginEnd="8dp"
            tools:text="Tajine de Poulet aux Olives" />

        <!-- PRIX UNITAIRE -->
        <TextView
            android:id="@+id/textViewPrixUnitaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/textViewNomPlat"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="15.50 €/u" />

        <!-- BOUTON SUPPRIMER (POUBELLE ROUGE) -->
        <ImageButton
            android:id="@+id/buttonRemove"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Supprimer"
            app:tint="#D32F2F"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONTRÔLES QUANTITÉ : [−] 2 [+] -->
        <LinearLayout
            android:id="@+id/layoutQuantite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/textViewPrixUnitaire"
            app:layout_constraintStart_toStartOf="parent">

            <!-- BOUTON MOINS (−) ROUGE -->
            <Button
                android:id="@+id/buttonMoins"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="−"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <!-- QUANTITÉ -->
            <TextView
                android:id="@+id/textViewQuantite"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginHorizontal="12dp"
                tools:text="2" />

            <!-- BOUTON PLUS (+) ROUGE -->
            <Button
                android:id="@+id/buttonPlus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- PRIX TOTAL DE LA LIGNE (en rouge) -->
        <TextView
            android:id="@+id/textViewPrixTotalLigne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/layoutQuantite"
            tools:text="31.00 €" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>